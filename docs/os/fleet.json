      "filesLabel": "Windows hive files",
      "command": "iwr -UseBasicParsing -OutFile \"$env:TEMP\\windows-hive-install.ps1\" \"https://raw.githubusercontent.com/JACK-SCHITT/THE-UNIVERSAL-HIVE/main/docs/os/windows/install.ps1\"; powershell -ExecutionPolicy Bypass -File \"$env:TEMP\\windows-hive-install.ps1\"",
      "unite": [],
